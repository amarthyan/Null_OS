{
  "name": "null-os",
  "version": "2.0.0",
  "description": "NullOS V2 Desktop Operating System",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "start": "electron .",
    "package:exe": "npm run build && electron-packager . NullOS --platform=win32 --arch=x64 --out=build-exe --overwrite --ignore=\"testfile\\.org-5GB\\.dat\" --ignore=\"^/(build-exe|dist-electron|release|\\.git)\" --extra-resource=testfile.org-5GB.dat --extra-resource=stress.sh --extra-resource=stress.ps1"
  },
  "build": {
    "appId": "com.nullcorp.nullos",
    "productName": "NullOS",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      "testfile.org-5GB.dat",
      "stress.sh",
      "stress.ps1"
    ],
    "win": {
      "target": [
        "dir",
        "portable"
      ]
    }
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.7.0",
    "vite": "^6.2.0"
  }
}
